# 本地验证默认仅监听回环地址；公网部署步骤见 docs/DEPLOYMENT.md。
SITE_ADDRESS=:80
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
APP_USERNAME=research

# 可选：Docker Hub 无法连接时，可使用官方镜像的 ECR Public 分发入口。
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim-bookworm
# POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:17-alpine
# CADDY_IMAGE=public.ecr.aws/docker/library/caddy:2-alpine

# 必填：使用随机十六进制数据库密码，避免 URL 特殊字符。
POSTGRES_PASSWORD=
# 必填：粘贴 Caddy 生成的 bcrypt 哈希，并保留单引号以避免 $ 被解释。
APP_PASSWORD_HASH=''

# 以下均为可选。未配置时可打开页面；相应外部服务功能不可用。
MINERU_TOKEN=
DMF_HISTORY_ENABLED=false
DMF_WATCHLIST_ENABLED=false
DMF_NOTIFICATION_ENABLED=false

# 保留现有模型接入，不自动迁移或触发调用。以后按代码支持的接口填入真实配置。
APOLLO_CLIENT_ID=
APOLLO_CLIENT_SECRET=
APOLLO_TOKEN_URL=
APOLLO_BASE_URL=
APOLLO_MODEL=
APOLLO_EMBEDDING_MODEL=
APOLLO_RERANK_MODEL=

# 不自动扩大窗口，接入模型后按真实容量显式配置。
AGENT_CONTEXT_WINDOW_TOKENS=16000
AGENT_CONTEXT_OUTPUT_TOKENS=2048
AGENT_CONTEXT_SAFETY_TOKENS=2048
