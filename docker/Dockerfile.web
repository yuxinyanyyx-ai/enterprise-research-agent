ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHON_DOTENV_DISABLED=1 \
    HOME=/home/app

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates tzdata libreoffice-impress libreoffice-writer fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home app

COPY requirements.txt .
RUN python -m pip install --no-cache-dir -r requirements.txt

COPY --chown=app:app src ./src
COPY --chown=app:app skills ./skills
COPY --chown=app:app alembic ./alembic
COPY --chown=app:app alembic.ini .
COPY --chown=app:app docker/web-entrypoint.sh /usr/local/bin/web-entrypoint

RUN sed -i 's/\r$//' /usr/local/bin/web-entrypoint \
    && chmod 755 /usr/local/bin/web-entrypoint \
    && mkdir -p /app/src/storage /app/data /app/outputs /app/logs /app/PDF \
    && chown -R app:app /app/src/storage /app/data /app/outputs /app/logs /app/PDF

USER app
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/web-entrypoint"]
